{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",

    /*
     * Two rules are switched off deliberately. Both fire on correct code in this app,
     * and silencing them is recorded here rather than left as unexplained warnings.
     */
    "react/only-export-components": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    {
      /*
       * A context provider and its matching `useX()` hook live in one file throughout —
       * `stores/auth.tsx`, `stores/theme.tsx`, `stores/realtime.tsx`, `components/ui/*`.
       * This is the shadcn/ui convention. Splitting the hook into a sibling file would
       * double the import surface for every consumer and buy only faster hot-reload of
       * a single component.
       */
      "files": ["src/stores/*.tsx", "src/components/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}