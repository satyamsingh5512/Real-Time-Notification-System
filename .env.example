# Copy to .env (git-ignored) and fill in real secrets. Never commit .env.
#   cp .env.example .env
# Local dev can accept the defaults; production MUST override JWT_SECRET and DB_PASSWORD.
# See docs/ORACLE_DEPLOYMENT.md for the production checklist.

# --- Profiles ---
SPRING_PROFILES_ACTIVE=docker

# --- Database (Postgres 16) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=notification_platform
DB_USER=notification_user
DB_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (Apache KRaft, internal) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Auth (REQUIRED in production: 32+ random bytes, fail-fast boot check) ---
# Generate: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-please-32-bytes-min
JWT_EXPIRATION_MS=3600000

# --- Delivery providers (blank = MockEmail/Sms/Push with SPRING_PROFILES_ACTIVE=local) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# --- DLQ alerting (Slack/PagerDuty webhook; empty = log + metrics only) ---
DLQ_ALERT_WEBHOOK_URL=

# --- Retention ---
NOTIFICATION_RETENTION_ENABLED=true
NOTIFICATION_RETENTION_DAYS=90
# NOTIFICATION_RETENTION_CRON=0 0 2 * * *

# --- Digest batching (Slack/SuprSend pattern) ---
# Low-value email is batched per user (cadence is per-user in the UI) and flushed as
# one grouped email on this cron. Empty digests are never sent.
DIGEST_ENABLED=true
DIGEST_CRON=0 15 * * * *

# --- Provider circuit breaker (SES/Twilio/FCM 429 + outage protection) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_COOLDOWN_SECONDS=60

# --- Consumer lag metrics (kafka.consumer.lag{group=...}) ---
KAFKA_LAG_MONITORED_GROUPS=notification-platform-events
KAFKA_LAG_POLL_INTERVAL_MS=30000

# --- Runtime ---
# Java 21 virtual threads for IO-bound WS fan-out and provider calls.
VIRTUAL_THREADS_ENABLED=true

# --- Rate limiting (Redis fixed-window, fail-open) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
# Stricter budget for auth endpoints (login/register), enforced in-app:
AUTH_RATE_LIMIT_PER_MINUTE=30
