# Copy to .env (git-ignored) and fill in real secrets. Never commit .env.
#   cp .env.example .env
# Local dev can accept the defaults; production MUST override JWT_SECRET and DB_PASSWORD.
# See docs/ORACLE_DEPLOYMENT.md for the production checklist.

# --- Profiles ---
SPRING_PROFILES_ACTIVE=docker

# --- Database (Postgres 16) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=notification_platform
DB_USER=notification_user
DB_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (Apache KRaft, internal) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Auth (REQUIRED in production: 32+ random bytes, fail-fast boot check) ---
# Generate: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-please-32-bytes-min
JWT_EXPIRATION_MS=3600000

# --- Delivery providers (blank = MockEmail/Sms/Push with SPRING_PROFILES_ACTIVE=local) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# --- External email service (github.com/satyamsingh5512/email-service) ---
# Disabled by default. When enabled it becomes the EMAIL transport and AWS SES is unused.
# See docs/EMAIL_SERVICE_INTEGRATION.md — read the "Before enabling" section first.
EMAIL_SERVICE_ENABLED=false
EMAIL_SERVICE_URL=http://email-service:3001
# Sent as `Authorization: Bearer`. The upstream currently ignores authentication
# entirely (its authenticate() middleware is a bypass), but set it anyway so this
# integration keeps working once that is fixed.
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_CONNECT_TIMEOUT_MS=3000
EMAIL_SERVICE_READ_TIMEOUT_MS=10000
# Mass-email campaigns are OFF by default. Highest abuse risk in the product, and the
# upstream enforces a hardcoded 100 sends/day quota that caps real campaigns.
EMAIL_SERVICE_MASS_MAIL_ENABLED=false
EMAIL_SERVICE_MASS_MAIL_MAX_RECIPIENTS=100
# Must match the upstream constant (backend/src/middleware/rateLimit.js) for the
# pre-flight quota warning to be accurate.
EMAIL_SERVICE_DAILY_QUOTA=100

# --- DLQ alerting (Slack/PagerDuty webhook; empty = log + metrics only) ---
DLQ_ALERT_WEBHOOK_URL=

# --- Retention ---
NOTIFICATION_RETENTION_ENABLED=true
NOTIFICATION_RETENTION_DAYS=90
# NOTIFICATION_RETENTION_CRON=0 0 2 * * *

# --- Digest batching (Slack/SuprSend pattern) ---
# Low-value email is batched per user (cadence is per-user in the UI) and flushed as
# one grouped email on this cron. Empty digests are never sent.
DIGEST_ENABLED=true
DIGEST_CRON=0 15 * * * *

# --- Provider circuit breaker (SES/Twilio/FCM 429 + outage protection) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_COOLDOWN_SECONDS=60

# --- Consumer lag metrics (kafka.consumer.lag{group=...}) ---
KAFKA_LAG_MONITORED_GROUPS=notification-platform-events
KAFKA_LAG_POLL_INTERVAL_MS=30000

# --- Runtime ---
# Java 21 virtual threads for IO-bound WS fan-out and provider calls.
VIRTUAL_THREADS_ENABLED=true

# --- Rate limiting (Redis fixed-window, fail-open) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
# Stricter budget for auth endpoints (login/register), enforced in-app:
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- TLS / edge (nginx.prod.conf is rendered from these at container start) ---
# Required by docker-compose.prod.yml: the stack refuses to boot without them.
# `docker compose -f docker-compose.prod.yml config` will tell you if one is missing.
#
# Get certs on the VM first:
#   sudo certbot certonly --webroot -w /opt/rtns/certroot -d notify.example.com
# (nginx serves /.well-known/acme-challenge/ from /usr/share/nginx/html, so the
#  webroot must match that path — see docker-compose.prod.yml for the nginx volume.)
NGINX_SERVER_NAME=notify.example.com
NGINX_TLS_CERT_PATH=/etc/letsencrypt/live/notify.example.com/fullchain.pem
NGINX_TLS_KEY_PATH=/etc/letsencrypt/live/notify.example.com/privkey.pem
# Do NOT set NGINX_ENVSUBST_FILTER here — docker-compose.prod.yml pins it to "NGINX_"
# so nginx's own $host/$remote_addr survive template rendering.

# Certificate renewal: nothing in this repo renews automatically. Certs expire at 90
# days. Schedule BOTH on the host:
#   certbot renew --quiet
#   docker compose -f docker-compose.prod.yml exec -T nginx nginx -s reload
# Example crontab (06:17 avoids the :00 spike shared by every certbot install):
#   17 6 * * * certbot renew --quiet && docker compose -f /opt/rtns/docker-compose.prod.yml exec -T nginx nginx -s reload
