# Local dev: copy to .env (git-ignored) and fill in real secrets.
# docker compose --env-file .env up -d

# Backend
JWT_SECRET=local-dev-secret-change-me-please-32-bytes-min
DB_PASSWORD=changeme

# Providers (leave blank to run delivery against mocks with SPRING_PROFILES_ACTIVE=local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# DLQ alerting (Slack/PagerDuty webhook; empty = log + metrics only)
DLQ_ALERT_WEBHOOK_URL=

# Retention
NOTIFICATION_RETENTION_DAYS=90

# Rate limiting
RATE_LIMIT_PER_MINUTE=300
